{
  "name": "@substancelabs/aztec-gateway-7683",
  "version": "1.0.0",
  "author": "Substance Labs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./src/artifacts ./target",
    "codegen": "aztec codegen target --outdir src/artifacts --force",
    "postprocess": "aztec-postprocess-contract",
    "compile": "${AZTEC_NARGO:-aztec-nargo} compile",
    "deploy": "bun scripts/deploy.ts",
    "format": "prettier --write \"src/ts/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test:js && bun test:nr",
    "test:js": "bunx jest --no-cache --runInBand --config jest.integration.config.json",
    "test:nr": "aztec test",
    "update": "aztec update --contract . && ./.github/scripts/update_contract.sh $(grep -oP 'tag\\s*=\\s*\"\\K[^\"]+' \"Nargo.toml\" | head -1) && bun install && bun update-readme-version",
    "update-readme-version": "bun ./.github/scripts/update-readme-version.js"
  },
  "dependencies": {
    "@aztec/accounts": "3.0.0-devnet.2",
    "@aztec/aztec.js": "3.0.0-devnet.2",
    "@aztec/kv-store": "3.0.0-devnet.2",
    "@aztec/noir-contracts.js": "3.0.0-devnet.2",
    "@aztec/pxe": "3.0.0-devnet.2",
    "@aztec/stdlib": "3.0.0-devnet.2",
    "@aztec/test-wallet": "3.0.0-devnet.2",
    "@defi-wonderland/aztec-standards": "3.0.0-devnet.2",
    "viem": "^2.23.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.5.1",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.4"
  },
  "resolutions": {
    "jackspeak": "2.1.1",
    "@aztec/foundation": "3.0.0-devnet.2"
  },
  "jest": {
    "testTimeout": 200000
  },
  "packageManager": "bun@latest"
}
