{
  "name": "@substancelabs/aztec-evm-bridge-sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for bridging assets between Aztec and EVM chains using ERC-7683",
  "license": "MIT",
  "author": "Substance Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/substance-labs/aztec-evm-bridge.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "aztec",
    "evm",
    "bridge",
    "erc7683",
    "crosschain",
    "intent",
    "sdk"
  ],
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "format": "prettier --write \"**/*.{json,ts}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@azguardwallet/client": "^0.4.2",
    "@aztec/accounts": "3.0.0-devnet.2",
    "@aztec/aztec.js": "3.0.0-devnet.2",
    "@aztec/foundation": "3.0.0-devnet.2",
    "@aztec/kv-store": "3.0.0-devnet.2",
    "@aztec/noir-contracts.js": "3.0.0-devnet.2",
    "@aztec/pxe": "3.0.0-devnet.2",
    "@aztec/stdlib": "3.0.0-devnet.2",
    "@lodestar/types": "^1.33.0",
    "viem": "^2.33.2"
  },
  "devDependencies": {
    "@azguardwallet/types": "^0.4.1",
    "@types/node": "^24.2.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.22.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
