{
  "name": "aztec-evm-bridge",
  "private": true,
  "packageManager": "bun@latest",
  "type": "module",
  "workspaces": [
    "packages/aztec/*",
    "packages/filler",
    "packages/sdk"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "lint": "bun run --filter='*' lint",
    "lint:fix": "bun run --filter='*' lint:fix",
    "format": "bun run --filter='*' format",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "husky",
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "deploy:all": "bun scripts/deploy/deploy-all.ts",
    "mint:aztec": "bun scripts/mint/mint-aztec.ts",
    "mint:evm": "bun scripts/mint/mint-evm.ts"
  },
  "dependencies": {
    "@aztec/accounts": "3.0.0-devnet.2",
    "@aztec/aztec.js": "3.0.0-devnet.2",
    "@aztec/foundation": "3.0.0-devnet.2",
    "@aztec/kv-store": "3.0.0-devnet.2",
    "@aztec/noir-contracts.js": "3.0.0-devnet.2",
    "@aztec/pxe": "3.0.0-devnet.2",
    "@aztec/stdlib": "3.0.0-devnet.2",
    "@aztec/test-wallet": "3.0.0-devnet.2",
    "@defi-wonderland/aztec-standards": "3.0.0-devnet.2",
    "dotenv": "^16.5.0",
    "viem": "^2.23.13"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": ">=10",
    "pinst": ">=2",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  },
  "lint-staged": {
    "*.{js,ts,json}": "prettier --write"
  },
  "resolutions": {
    "@aztec/foundation": "3.0.0-devnet.2"
  }
}
